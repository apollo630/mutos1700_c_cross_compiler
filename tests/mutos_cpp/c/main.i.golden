extern int Cmask, Stand, ROroot;
extern char buffers[][1024		+0		];
extern char Mmsg[];
extern daddr_t getlong();
int fpp = 0;

main(p)
int p;
{

	if(Stand == 0)
		printf("\nDevice initialization:\n\n");
	if(fpp)
		printf("NDP      found\n");
	initpic();
	startup(p);
	


	generic(p);
	if(Stand == 0)
		printf("%s mem = %Dk\n",Mmsg, (((long)maxmem)<<11		)/0x400L);
	mfree(swapmap, nswap, 1);
	swplo--;

	proc[0].p_stat = 3		;
	proc[0].p_flag |= 01		|02		;
	proc[0].p_nice = 20;
	proc[0].p_addr = malloc(coremap,1		);
	proc[0].p_size = 1		;
	proc[0].p_dusize = 1		;
	u.u_procp = &proc[0];
	u.u_cmask = Cmask;
	Nproca = &proc[Nproc = 2];

	




	cinit();
	binit();
	spl7();
	initpic();
	clkstar();
	tasktime(0);
	iinit();
	(*bdevsw[	(int)(((unsigned)(swapdev)>>8))].d_open)(swapdev,1);
	rootdir = iget(rootdev, (ino_t)((ino_t)2)	);
	rootdir->i_flag &= ~01		;
	u.u_cdir = iget(rootdev, (ino_t)((ino_t)2)	);
	u.u_cdir->i_flag &= ~01		;
	u.u_rdir = 0;

	update();

	




	if(newproc()) {
		expand((int) (((unsigned)(szicode)+(2048		-1))>>11		) + 1		);
		u.u_tsize = 0;
		u.u_dsize =  (((unsigned)(szicode)+(2048		-1))>>11		);
		u.u_ssize = 1		;

		copyout((caddr_t)icode, (caddr_t)0, szicode << 1);
		



		return( (((unsigned)(proc[1].p_addr + 1		))<<7));
	}
	sched();
}












time_t bootime;

iinit()
{
	register struct buf *cp, *bp;
	register struct filsys *fp;

FLY1:
	u.u_error = 0;
	(*bdevsw[	(int)(((unsigned)(rootdev)>>8))].d_open)(rootdev, 1);
	bp = bread(rootdev, ((daddr_t)1)	);
	cp = geteblk();
	if(u.u_error)
	{
		if(Stand)
		{
			rootdev = pipedev = 	(dev_t)((0)<<8 | (44 + 1));
			goto FLY1;
		}
		else
			panic("iinit");
	}
	bcopy(bp->b_un.b_addr, cp->b_un.b_addr, sizeof(struct filsys));
	brelse(bp);
	mount[0].m_bufp = cp;
	mount[0].m_dev = rootdev;
	fp = cp->b_un.b_filsys;
	fp->s_flock = 0;
	fp->s_ilock = 0;
	fp->s_ronly = ROroot;
	if(fp->s_clean != 0106        	) {
		icodech();
		fp->s_clean = (~0106        	)	;
	} else
		fp->s_clean = 0;
	fp->s_fmod++;
	bootime = time = fp->s_time;
}






binit()
{
	register struct buf *bp;
	register struct buf *dp;
	register int i;
	struct bdevsw *bdp;

	bfreelist.b_forw = bfreelist.b_back =
	    bfreelist.av_forw = bfreelist.av_back = &bfreelist;
	for (i=0; i<v.v_buf; i++) {
		bp = &buf[i];
		bp->b_dev = (dev_t)(-1);
		bp->b_un.b_addr = &buffers[i][0		];
		bp->b_back = &bfreelist;
		bp->b_forw = bfreelist.b_forw;
		bfreelist.b_forw->b_back = bp;
		bfreelist.b_forw = bp;
		bp->b_flags = 010	;
		brelse(bp);
	}
	for (bdp = bdevsw; bdp < &bdevsw[nblkdev]; bdp++) {
		dp = bdp->d_tab;
		if(dp) {
			dp->b_forw = dp;
			dp->b_back = dp;
		}
	}
}

copyseg(from, to)
int from, to;
{
	copyblocks( ((from)*(2048		/1024		)),  ((to)*(2048		/1024		)), 2048		/1024		);
}

