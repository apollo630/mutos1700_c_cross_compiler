typedef unsigned short USHORT;
typedef long ULONG;           
typedef char UCHAR;           

struct identDev {             
  USHORT unused1[23];         
  UCHAR  firmware[8];         
  UCHAR  model[40];           
  USHORT unused2[2];          
  USHORT capab;               
  USHORT unused3[10];         
  ULONG  lbasecs;             
  USHORT unused4[194];        
};         

struct ptent {                
  USHORT  unused5[4];         
  daddr_t bas;                
  daddr_t siz;                
};

struct devinfo {              
  int present;                
  daddr_t sectors;            
};

struct hd {                   
  int unit;                   
  int scnt;                   
  int read;                   
  daddr_t snum;               
  caddr_t addr;               
  int segm;                   
};

struct part {
  daddr_t base;               
  daddr_t size;               
};

static struct identDev identDev;
static struct devinfo devinfo[2];
static struct hd hd;
static struct part part[2][1+   4             ]; 
struct buf rhdbuf;     				
struct buf hdtab;							


static int currUnit = -1;     
static int haveV30IDE = 0;     

static int hdrw(), smplCmd(), await();
static ident(), swtchDev(), delay(), bpEnxio();


extern int Stand;


extern int inb();
extern outb();
extern int hdio();            
extern int isNEC();           


hdinit()
{

  int valPA;                  

  




  outb(     0xe02c        ,   0x4           );            
  delay();
  outb(     0xe02c        ,  0x0           );           
  delay();  

  





 
  hd.unit = 0;                

  if (isNEC()) {
    ident(  0);
    haveV30IDE = devinfo[hd.unit].present;
  }

  if (Stand == 0) {
    printf("V30 IDE  Based %x %s.\n",    0xe000,
           haveV30IDE ? "found" : "NOT found"); 
    if (haveV30IDE) {
      for (hd.unit = 0; hd.unit < 2; hd.unit++) {
        printf(" %s ", hd.unit ? "Slave: " : "Master:");
        ident(1);
      }
      hd.unit = 0;
    }
  }

  







  if (haveV30IDE) {
    valPA = inb( 0xc8          );      
    valPA = valPA & 0xef          ;  
    outb(0xce          , 0x84);      
    outb( 0xc8          , valPA);      
    outb(0xce          , 0x94           );   
  }
}


hdopen(dev)
dev_t dev;
{
  register int unit;
  struct buf *bp;
  struct ptent *peptr;        
  int i;

  if (!haveV30IDE) {
    u.u_error = 6;
    return;
  }

  
  unit =  ((	(int)((dev)&0377) & 0x08) >> 3);
  if (unit == 1) {
    hd.unit = unit;
		




		currUnit = -1;
    ident(  0);									
  }

  
  if(!devinfo[unit].present) {
    u.u_error = 6;
    return;
  }

  
  if ((unit == 0) && part[unit][0].size)
    return;                   

  
  for (i = 0; i <=    4             ; i++) {
    part[unit][i].base = 0;
    part[unit][i].size = 0; 
  }
  
  part[unit][0].size = devinfo[unit].sectors;

  
  bp = bread((3              << 8) | ( ((	(int)((dev)&0377) & 0x08) >> 3) << 3), (daddr_t)0 );
  if ( ((bp->b_flags & 04	) == 0) &&
       (*(unsigned short *)(bp->b_un.b_addr + 510) == 0xaa55        ) ) {
    peptr = (struct ptent *)(bp->b_un.b_addr +   0x1be         );
    for (i = 1; i <=    4             ; peptr++, i++) {

      *(USHORT *)&part[unit][i].base = *((USHORT *)&peptr->bas + 1);
      *((USHORT *)&part[unit][i].base + 1) = *(USHORT *)&peptr->bas;
      *(USHORT *)&part[unit][i].size = *((USHORT *)&peptr->siz + 1);
      *((USHORT *)&part[unit][i].size + 1) = *(USHORT *)&peptr->siz;

    }
  }
  brelse(bp);                 
}


hdclose(dev, flag)
dev_t dev;
int flag;
{
  if (( dev == rootdev ) || ( dev == swapdev ))
    return;

  hd.unit =  ((	(int)((dev)&0377) & 0x08) >> 3);
  if (smplCmd(0xe7                ))       
    

    if ( !(inb(  0xe012        ) &    0x04          ) )
      u.u_error = 5;
}


hdstrategy(bp)
register struct buf *bp;
{
  int unit, partnum;         
  int bcnt, scnt;							
  daddr_t snum;								
  int err;
  unsigned addr;

  
  if (bp->b_flags & 020	) {
    

    if ( (bp->b_blkno % 512) || (bp->b_bcount % 512) ) {
      bp->b_flags |= 04	;
      bp->b_error = 22;
      iodone(bp);
      return;
    }
    
    snum = bp->b_blkno >> (daddr_t) 9;
		
		scnt = bp->b_bcount >> 9;
  } 
  
  else {
    
    snum = bp->b_blkno << (daddr_t)  ( (  (1024		/512)     )==16 ? 4 : (  (1024		/512)     )==8 ? 3 : (  (1024		/512)     )==4 ? 2 : (  (1024		/512)     )==2 ? 1 : 0 );
    
    bcnt = (bp->b_bcount + 01777		) >> 10		;
    
    scnt = bcnt <<  ( (  (1024		/512)     )==16 ? 4 : (  (1024		/512)     )==8 ? 3 : (  (1024		/512)     )==4 ? 2 : (  (1024		/512)     )==2 ? 1 : 0 ); 
	}

  unit =  ((	(int)((bp->b_dev)&0377) & 0x08) >> 3);
  partnum =  (	(int)((bp->b_dev)&0377) & 0x07);

  




  if (snum + scnt > part[unit][partnum].size) {
    bpEnxio(bp);
    return;
  }

  if (scnt == 0) {
    bp->b_resid = 0;
    iodone(bp);
    return;
  }

  hd.unit = unit;
  hd.scnt = scnt;
  hd.read = bp->b_flags & 01	;
  hd.snum = part[unit][partnum].base + snum;

  








  
  

  hd.segm = ((int)bp->b_xmem) << 12;                  
  addr    = ((unsigned)bp->b_un.b_addr) >> 4;        
  hd.segm += addr;                                   
  hd.addr = (caddr_t)(((int)bp->b_un.b_addr) & 0xf); 

  err = hdrw();
  if (err) {
    deverror(bp, hd.read ? 0x20           : 0x30          , err);
    bp->b_flags |= 04	;
    bp->b_error = 5;
  }
  
  iodone(bp);  
}



hdread(dev)
dev_t dev;
{
  physio(hdstrategy, &rhdbuf, dev, 01	);
}

hdwrite(dev)
dev_t dev;
{
  physio(hdstrategy, &rhdbuf, dev, 0	);
}









static ident(verbose)
int verbose;
{
  int i;
  char model[41];              
  char firmware[9];           
  daddr_t sectors;            

  devinfo[hd.unit].present = 0;
  devinfo[hd.unit].sectors = 0;

  if (!smplCmd(0xec          ) && !hdio(0x0000		, &identDev, 1, 1)) {

    for (i = 0; i < sizeof(identDev.model); i+=2) {
      model[i] = identDev.model[i+1];
      model[i+1] = identDev.model[i];
    }
    model[40] = '\0';
    for (i = 0; i < sizeof(identDev.firmware); i+=2) {
      firmware[i] = identDev.firmware[i+1];
      firmware[i+1] = identDev.firmware[i];
    }
    firmware[8] = '\0';










    *(USHORT *)&sectors = *((USHORT *)&identDev.lbasecs + 1);
    *((USHORT *)&sectors + 1) = *(USHORT *)&identDev.lbasecs;


    if (identDev.capab &  0x200         ) {
      devinfo[hd.unit].present = 1;
      devinfo[hd.unit].sectors = sectors;
    }
  }

  if (verbose) {
    if (devinfo[hd.unit].present) {
      printf("%s FW: %s\n", model, firmware);
      printf("  %D 512-byte sectors, %D %d-byte blocks (%D MiB)\n", 
                         sectors, sectors/  (1024		/512)     , 1024		, sectors/2/1024);
    } else
      printf("not found\n");
  }
}










static int hdrw()
{
  register int status;

  if (await(   0xe01e        ,     0x80           |     0x08          )) 
    return    1             ;

  

  if (currUnit != hd.unit) {
    swtchDev();
    if (await(   0xe01e        ,     0x80           |     0x08          ))
    return    1             ;
  }

  outb(     0xe02c        ,  0x2           );           
  outb(     0xe012        , 0);
  outb(     0xe014        , hd.scnt);
  outb(     0xe016        , (int)hd.snum);
  outb(     0xe018        , (int)(hd.snum >> 8));
  outb(     0xe01a        , (int)(hd.snum >> 16));
  outb(     0xe01c        ,     0x40           | (hd.unit ?    0xb0           :    0xa0          ) | ( ((int)(hd.snum >> 24)) & 0xf));
  outb(    0xe01e        , hd.read ? 0x20           : 0x30          );
  
  return( hdio(hd.segm, hd.addr, hd.scnt, hd.read) );
}


static int smplCmd(cmd)
int cmd;
{
	register int status;

  if (await(   0xe01e        ,     0x80           |     0x08          ))   
    return    1             ;              

  if (currUnit != hd.unit) {
    swtchDev();
    if (await(   0xe01e        ,     0x80           |     0x08          ))
      return    1             ;
  }
 
  outb(    0xe01e        , cmd);
  if (await(   0xe01e        ,     0x80          ))
    return    1             ;

	status = inb(   0xe01e        );
  if (status & (    0x80           |      0x20           |     0x01          ))
    
    return((status << 8) |    2             );

  return 0;       
}


static swtchDev()
{
  outb(     0xe01c        , hd.unit ?    0xb0           :    0xa0          );
  currUnit = hd.unit;
  delay();
}


static delay()
{
  inb(   0xe01e        );
  inb(   0xe01e        );
  inb(   0xe01e        );
  inb(   0xe01e        );
}






  
static int await(port, mask)
int port;
int mask;
{
  unsigned int i;
  
  for (i = 0; i < 65535         ; i++)
    if ((inb(port) & mask) == 0)
      return 0;
  return -1;
}


static bpEnxio(bp)
struct buf *bp;
{
  bp->b_flags |= 04	;
  bp->b_error = 6;
  iodone(bp);
}
