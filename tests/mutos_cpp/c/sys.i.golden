syopen(dev, flag)
{

	if(u.u_ttyp == 0) {
		u.u_error = 6;
		return;
	}
	(*cdevsw[	(int)(((unsigned)(u.u_ttyd)>>8))].d_open)(u.u_ttyd, flag);
}

syread(dev)
{

	(*cdevsw[	(int)(((unsigned)(u.u_ttyd)>>8))].d_read)(u.u_ttyd);
}

sywrite(dev)
{

	(*cdevsw[	(int)(((unsigned)(u.u_ttyd)>>8))].d_write)(u.u_ttyd);
}

syioctl(dev, cmd, addr, flag)
caddr_t addr;
{

	(*cdevsw[	(int)(((unsigned)(u.u_ttyd)>>8))].d_ioctl)(u.u_ttyd, cmd, addr, flag);
}
