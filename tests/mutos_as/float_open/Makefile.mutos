# Makefile.mutos -- float_open (this directory's current probe only).
#
# Genuine V7/MUTOS make(1)-compatible makefile, run from INSIDE this
# directory ON THE REAL MUTOS 1700 hardware / emulator:
#
#   make -f Makefile.mutos
#   make -f Makefile.mutos clean
#
# There is NO CURRENT PROBE: fltopen.s (2026-09-28), fltmode.s and
# fltmul.s (2026-09-29) were run here with rules of this shape and have
# moved to ../float_coverage/ with their goldens. A new probe gets its
# own rule, e.g.
#
#   all: fltnew.o
#
#   fltnew.o: fltnew.s
#   	$(AS) -o fltnew.o fltnew.s
#
# One recipe, one shell line, per make(1)'s own note (see
# tests/mutos_cc/00_smoke/Makefile.mutos) that shell state doesn't carry
# across separate recipe lines.

AS = as

all:

clean:
