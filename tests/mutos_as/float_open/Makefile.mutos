# Makefile.mutos -- float_open (this directory's current probe only).
#
# Genuine V7/MUTOS make(1)-compatible makefile, run from INSIDE this
# directory ON THE REAL MUTOS 1700 hardware / emulator:
#
#   make -f Makefile.mutos
#   make -f Makefile.mutos clean
#
# Assembles fltmode.s with the REAL "as": the third round of
# floating-point probes, to pin down how the real assembler's double
# arithmetic rounds (see README.md). fltmode.o is expected to assemble
# cleanly here; the CURRENT mutos_as refuses eight of its ten constants
# by design, so this directory is NOT part of the top-level "make test".
# (The previous probe here, fltopen.s, was run on real hardware
# 2026-09-28 with the same rule shape and has moved to
# ../float_coverage/.)
#
# One recipe, one shell line, per make(1)'s own note (see
# tests/mutos_cc/00_smoke/Makefile.mutos) that shell state doesn't carry
# across separate recipe lines.

AS = as

all: fltmode.o

fltmode.o: fltmode.s
	$(AS) -o fltmode.o fltmode.s

clean:
	rm -f fltmode.o
