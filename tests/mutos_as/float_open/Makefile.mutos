# Makefile.mutos -- float_open (this directory's probes only).
#
# Genuine V7/MUTOS make(1)-compatible makefile, run from INSIDE this
# directory ON THE REAL MUTOS 1700 hardware / emulator:
#
#   make -f Makefile.mutos
#   make -f Makefile.mutos clean
#
# No open probe. fltsig.s stays as evidence: the real "as" refuses it -
# run 2026-09-29 with this rule, it printed "***ERROR*** floating point
# over/under flow- assembly aborted" (twice, "line 41") and exited with
# status 4, no object (see README.md) - so "make -f Makefile.mutos"
# here is EXPECTED to stop with "*** Error code 4". The earlier probes
# (fltopen.s, fltmode.s, fltmul.s, fltovf.s) were run with rules of this
# shape and have moved to ../float_coverage/. A new probe gets its own
# rule and goes into "all".
#
# One recipe, one shell line, per make(1)'s own note (see
# tests/mutos_cc/00_smoke/Makefile.mutos) that shell state doesn't carry
# across separate recipe lines.

AS = as

all: fltsig.o

fltsig.o: fltsig.s
	$(AS) -o fltsig.o fltsig.s

clean:
	rm -f fltsig.o core
