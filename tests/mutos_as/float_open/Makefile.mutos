# Makefile.mutos -- float_open (this directory's current probe only).
#
# Genuine V7/MUTOS make(1)-compatible makefile, run from INSIDE this
# directory ON THE REAL MUTOS 1700 hardware / emulator:
#
#   make -f Makefile.mutos
#   make -f Makefile.mutos clean
#
# Assembles fltmul.s with the REAL "as": the fourth round of
# floating-point probes, to pin down which product the real assembler's
# double multiplication rounds, and zeros with decimal exponent 0 (see
# README.md). fltmul.o is expected to assemble cleanly here; the CURRENT
# mutos_as refuses nine of its ten constants by design, so this
# directory is NOT part of the top-level "make test". (The previous
# probes here, fltopen.s and fltmode.s, were run on real hardware with
# the same rule shape and have moved to ../float_coverage/.)
#
# One recipe, one shell line, per make(1)'s own note (see
# tests/mutos_cc/00_smoke/Makefile.mutos) that shell state doesn't carry
# across separate recipe lines.

AS = as

all: fltmul.o

fltmul.o: fltmul.s
	$(AS) -o fltmul.o fltmul.s

clean:
	rm -f fltmul.o
