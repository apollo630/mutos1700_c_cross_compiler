














seven()
{
	return 7;
}

main()
{
	int a[3], b[3];
	int i, j, x, y, s, r;

	i = 1;
	j = 2;
	x = 17;
	y = 5;
	a[1] = 6;
	b[2] = 3;
	r = 0;
	s = x / y + 3;
	r = r + s;
	s = seven() + 1;
	r = r + s;
	s = x * y - 1;
	r = r + s;
	s = j + 0;
	r = r + s;
	s = j - 0;
	r = r + s;
	s = a[i] * b[j];
	r = r + s;
	s = a[i] & b[j];
	r = r + s;
	x /= seven();
	y %= seven();
	return r + x + y;
}
