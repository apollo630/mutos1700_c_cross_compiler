






















main()
{
	double a[3], d, e, v, w, y;
	int i, x, r;

	r = 0;
	i = 1;
	a[0] = 0.5;
	a[1] = 1.5;
	a[2] = 2.5;
	e = 0.5;
	v = 3.0;
	w = 4.0;
	y = 10.0;
	d = 1.5;
	e = (d += ++w * ++y) + 1.0;
	r = r + e + d + w + y;
	d = 1.5;
	e = (d += ++w - ++y) + 1.0;
	r = r + e + d + w + y;
	d = 1.5;
	e = (d += ++w + ++y) - 1.0;
	r = r + e + d + w + y;
	d = 1.5;
	e = 1.0 + (d += ++w + ++y);
	r = r + e + d + w + y;
	d = 1.5;
	e = (d += --w + --y + 1.0) + 2.0;
	r = r + e + d + w + y;
	d = 1.5;
	e = (d += ++w + ++y) + (v -= 1.0);
	r = r + e + d + v;
	d = 1.5;
	x = (d += ++w + 1.0) > 2.0;
	r = r + x + d;
	d = 1.5;
	x = (d -= ++w + ++y) < 0.0;
	r = r + x + d;
	d = 1.5;
	x = 2.0 < (d += ++w + ++y);
	r = r + x + d;
	d = 1.5;
	x = 0;
	if ((d += ++w + ++y) > 2.0)
		x = 1;
	r = r + x + d;
	d = 1.5;
	x = (d += ++w + ++y) == (v += 1.0);
	r = r + x + d + v;
	d = 1.5;
	x = (d += w + y) > 2.0;
	r = r + x + d;
	d = 1.5;
	e = 0.5;
	x = (d += a[i] * e) > 2.0;
	r = r + x + d * 4.0;
	d = 1.5;
	e = (d += ++w + ++y) / 2.0;
	r = r + e + d;
	d = 1.5;
	e = (d *= ++w + ++y) + 1.0;
	r = r + e + d;
	d = 1.5;
	e = -(d += ++w + ++y);
	r = r + e + d + w + y;
	return r;
}
