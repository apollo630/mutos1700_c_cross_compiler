










main()
{
	double d, e, arr[2];
	int i, j, r;

	i = 1;
	j = 3;
	r = 0;
	d = 2.0;
	e = 1.5;
	arr[0] = 0.5;
	arr[1] = 4.0;
	d = (double) i + (double) j;
	r = r + (int) d;
	d = arr[i] + j;
	r = r + (int) d;
	d = (d * e) - (i - j);
	r = r + (int) d;
	d = (d / e) + (i << 1);
	r = r + (int) d;
	d = (d * e) + (j + 0);
	r = r + (int) d;
	j /= e;
	r = r + j;
	d = d + 0.0;
	d = d - 0.0;
	return r + (int) d - 30;
}
