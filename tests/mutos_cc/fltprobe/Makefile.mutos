# Makefile.mutos -- fltprobe/ (this directory's 13 files only).
#
# Genuine V7/MUTOS make(1)-compatible makefile, run from INSIDE this
# directory on real MUTOS 1700 hardware - the same recipes as every
# corpus category's own Makefile.mutos (see ../06_struct/Makefile.mutos
# for why there is one small makefile per directory, and why ".s" comes
# from a plain "cc -S", never "cc -P -S"):
#
#   make -f Makefile.mutos
#   make -f Makefile.mutos clean
#
# The ".s", ".i", ".1" and ".2" files it makes are brought back to the
# modern host and packaged there ("make goldens" in ..), exactly as for
# the corpus - see README.md in this directory for what each file probes.
#
# Every recipe is one shell line (";"-joined), per make(1)'s own
# FEHLERQUELLEN note that shell state doesn't carry across separate
# recipe lines.

CC  = cc
CPP = /lib/cpp
C0  = /lib/c0

# Two rounds - the second (p6..p9) added after the first round's goldens
# came back; "make -f Makefile.mutos round2" makes only the new ones.
all: round1 round2

round1: 03_fltcmp.s 03_fltcmp.1 04_fltconst.s 04_fltconst.1 05_fltasop.s 05_fltasop.1 06_fltfunc.s 06_fltfunc.1 p1_compare.s p1_compare.1 p2_arith.s p2_arith.1 p3_global.s p3_global.1 p4_const.s p4_const.1 p5_call.s p5_call.1

round2: p6_dblcon.s p6_dblcon.1 p7_itofreg.s p7_itofreg.1 p8_misc.s p8_misc.1 p9_init.s p9_init.1

03_fltcmp.s: 03_fltcmp.c
	$(CC) -S 03_fltcmp.c

03_fltcmp.1: 03_fltcmp.c
	$(CPP) -P 03_fltcmp.c > 03_fltcmp.i; $(C0) 03_fltcmp.i 03_fltcmp.1 03_fltcmp.2

04_fltconst.s: 04_fltconst.c
	$(CC) -S 04_fltconst.c

04_fltconst.1: 04_fltconst.c
	$(CPP) -P 04_fltconst.c > 04_fltconst.i; $(C0) 04_fltconst.i 04_fltconst.1 04_fltconst.2

05_fltasop.s: 05_fltasop.c
	$(CC) -S 05_fltasop.c

05_fltasop.1: 05_fltasop.c
	$(CPP) -P 05_fltasop.c > 05_fltasop.i; $(C0) 05_fltasop.i 05_fltasop.1 05_fltasop.2

06_fltfunc.s: 06_fltfunc.c
	$(CC) -S 06_fltfunc.c

06_fltfunc.1: 06_fltfunc.c
	$(CPP) -P 06_fltfunc.c > 06_fltfunc.i; $(C0) 06_fltfunc.i 06_fltfunc.1 06_fltfunc.2

p1_compare.s: p1_compare.c
	$(CC) -S p1_compare.c

p1_compare.1: p1_compare.c
	$(CPP) -P p1_compare.c > p1_compare.i; $(C0) p1_compare.i p1_compare.1 p1_compare.2

p2_arith.s: p2_arith.c
	$(CC) -S p2_arith.c

p2_arith.1: p2_arith.c
	$(CPP) -P p2_arith.c > p2_arith.i; $(C0) p2_arith.i p2_arith.1 p2_arith.2

p3_global.s: p3_global.c
	$(CC) -S p3_global.c

p3_global.1: p3_global.c
	$(CPP) -P p3_global.c > p3_global.i; $(C0) p3_global.i p3_global.1 p3_global.2

p4_const.s: p4_const.c
	$(CC) -S p4_const.c

p4_const.1: p4_const.c
	$(CPP) -P p4_const.c > p4_const.i; $(C0) p4_const.i p4_const.1 p4_const.2

p5_call.s: p5_call.c
	$(CC) -S p5_call.c

p5_call.1: p5_call.c
	$(CPP) -P p5_call.c > p5_call.i; $(C0) p5_call.i p5_call.1 p5_call.2

p6_dblcon.s: p6_dblcon.c
	$(CC) -S p6_dblcon.c

p6_dblcon.1: p6_dblcon.c
	$(CPP) -P p6_dblcon.c > p6_dblcon.i; $(C0) p6_dblcon.i p6_dblcon.1 p6_dblcon.2

p7_itofreg.s: p7_itofreg.c
	$(CC) -S p7_itofreg.c

p7_itofreg.1: p7_itofreg.c
	$(CPP) -P p7_itofreg.c > p7_itofreg.i; $(C0) p7_itofreg.i p7_itofreg.1 p7_itofreg.2

p8_misc.s: p8_misc.c
	$(CC) -S p8_misc.c

p8_misc.1: p8_misc.c
	$(CPP) -P p8_misc.c > p8_misc.i; $(C0) p8_misc.i p8_misc.1 p8_misc.2

p9_init.s: p9_init.c
	$(CC) -S p9_init.c

p9_init.1: p9_init.c
	$(CPP) -P p9_init.c > p9_init.i; $(C0) p9_init.i p9_init.1 p9_init.2

clean:
	rm -f *.s *.i *.1 *.2
