# Makefile.mutos -- fltprobe/ (this directory's 45 files only).
#
# Genuine V7/MUTOS make(1)-compatible makefile, run from INSIDE this
# directory on real MUTOS 1700 hardware - the same recipes as every
# corpus category's own Makefile.mutos (see ../06_struct/Makefile.mutos
# for why there is one small makefile per directory, and why ".s" comes
# from a plain "cc -S", never "cc -P -S"):
#
#   make -f Makefile.mutos
#   make -f Makefile.mutos clean
#
# The ".s", ".i", ".1" and ".2" files it makes are brought back to the
# modern host and packaged there ("make goldens" in ..), exactly as for
# the corpus - see README.md in this directory for what each file probes.
#
# Every recipe is one shell line (";"-joined), per make(1)'s own
# FEHLERQUELLEN note that shell state doesn't carry across separate
# recipe lines.

CC  = cc
CPP = /lib/cpp
C0  = /lib/c0

# Ten rounds - each added after the previous round's goldens came back
# (p6..p9, then p10..p13, p14..p16, p17..p19, p20..p23, p24..p28,
# p29..p33, p34..p37, p38..p41); "make -f Makefile.mutos round10" makes
# only the newest ones. Should one of them fail to compile on MUTOS, make
# the others by name ("make -f Makefile.mutos p39_elem7.s p39_elem7.1") -
# the failing file's compiler messages are themselves the finding.
# p28_fltstk, p37_fltstk3 and p41_fltstk4 are MEANT to make "cc" report
# errors (see the files), and p30_fltstk2 was expected to: their "cc -S"
# lines start with "-", so make goes on, and the ".s" is written all the
# same.
all: round1 round2 round3 round4 round5 round6 round7 round8 round9 round10

round1: 03_fltcmp.s 03_fltcmp.1 04_fltconst.s 04_fltconst.1 05_fltasop.s 05_fltasop.1 06_fltfunc.s 06_fltfunc.1 p1_compare.s p1_compare.1 p2_arith.s p2_arith.1 p3_global.s p3_global.1 p4_const.s p4_const.1 p5_call.s p5_call.1

round2: p6_dblcon.s p6_dblcon.1 p7_itofreg.s p7_itofreg.1 p8_misc.s p8_misc.1 p9_init.s p9_init.1

round3: p10_elem.s p10_elem.1 p11_itof2.s p11_itof2.1 p12_init2.s p12_init2.1 p13_open.s p13_open.1

round4: p14_axint.s p14_axint.1 p15_fltinf.s p15_fltinf.1 p16_open2.s p16_open2.1

round5: p17_elem2.s p17_elem2.1 p18_fltop3.s p18_fltop3.1 p19_open3.s p19_open3.1

round6: p20_fltlv.s p20_fltlv.1 p21_fltexp.s p21_fltexp.1 p22_long2.s p22_long2.1 p23_elem3.s p23_elem3.1

round7: p24_fltinf2.s p24_fltinf2.1 p25_long3.s p25_long3.1 p26_elem4.s p26_elem4.1 p27_frame.s p27_frame.1 p28_fltstk.s p28_fltstk.1

round8: p29_frame2.s p29_frame2.1 p30_fltstk2.s p30_fltstk2.1 p31_long4.s p31_long4.1 p32_elem5.s p32_elem5.1 p33_fltinf3.s p33_fltinf3.1

round9: p34_long5.s p34_long5.1 p35_elem6.s p35_elem6.1 p36_fltinf4.s p36_fltinf4.1 p37_fltstk3.s p37_fltstk3.1

round10: p38_long6.s p38_long6.1 p39_elem7.s p39_elem7.1 p40_fltinf5.s p40_fltinf5.1 p41_fltstk4.s p41_fltstk4.1

03_fltcmp.s: 03_fltcmp.c
	$(CC) -S 03_fltcmp.c

03_fltcmp.1: 03_fltcmp.c
	$(CPP) -P 03_fltcmp.c > 03_fltcmp.i; $(C0) 03_fltcmp.i 03_fltcmp.1 03_fltcmp.2

