









main()
{
	double d, e;
	float a;
	int r;

	d = 1.5;
	e = 2.5;
	a = 0.5;
	r = 0;
	e = d + 0.1;
	e = 0.1 + d;
	e = a * 0.1;
	e = 0.1 * a;
	e = d * 0.1 + e;
	if (d < 0.1)
		r = r + 1;
	if (0.1 < d)
		r = r + 2;
	if (a > 0.1)
		r = r + 4;
	if (0.1 > a)
		r = r + 32;
	e = (d + e) * 0.1;
	r = r + (int) (e * 20);
	return r;
}
