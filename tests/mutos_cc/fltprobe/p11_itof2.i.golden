












seven()
{
	return 7;
}

main()
{
	double d, e;
	int i, j, r;

	i = 13;
	j = 4;
	r = 0;
	e = 2.0;
	d = 0.5 + (i << 2);
	r = r + (int) d;
	d = e + (i - 6);
	r = r + (int) d;
	d = e + (0 - i);
	r = r + (int) d;
	d = e + i / j;
	r = r + (int) d;
	d = (d / e) + i * 3;
	r = r + (int) d;
	i += seven();
	i -= seven();
	return r + i;
}
