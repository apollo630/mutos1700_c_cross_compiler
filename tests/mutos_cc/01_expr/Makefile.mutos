# Makefile.mutos -- per-category (this directory's 8 files only).
#
# Genuine V7/MUTOS make(1)-compatible makefile, run from INSIDE this
# directory (no "cd" needed in the recipes below, unlike the old
# top-level version):
#
#   make -f Makefile.mutos
#   make -f Makefile.mutos clean
#
# This replaces a single tests/mutos_cc/Makefile.mutos that tried to
# cover all 62 test files (124 targets) in one file -- that one hit
# "Make: out of memory. Stop." on real MUTOS 1700 hardware partway
# through the very first (smallest) category. One small makefile per
# category, run one category at a time, stays well within whatever
# fixed-size internal table that make(1) ran out of. This also matches
# the corpus's own intended "tackle one category at a time" order (see
# ../README.md).
#
# Every recipe is one shell line (";"-joined), per make(1)'s own
# FEHLERQUELLEN note that shell state doesn't carry across separate
# recipe lines.

CC  = cc
CPP = /lib/cpp
C0  = /lib/c0

all: 01_intarith.s 01_intarith.1 02_bitwise.s 02_bitwise.1 03_rellogic.s 03_rellogic.1 04_shift.s 04_shift.1 05_incdec.s 05_incdec.1 06_compasgn.s 06_compasgn.1 07_ternary.s 07_ternary.1 08_castsize.s 08_castsize.1

01_intarith.s: 01_intarith.c
	$(CC) -P -S 01_intarith.c

01_intarith.1: 01_intarith.c
	$(CPP) -P 01_intarith.c > 01_intarith.i; $(C0) 01_intarith.i 01_intarith.1 01_intarith.2

02_bitwise.s: 02_bitwise.c
	$(CC) -P -S 02_bitwise.c

02_bitwise.1: 02_bitwise.c
	$(CPP) -P 02_bitwise.c > 02_bitwise.i; $(C0) 02_bitwise.i 02_bitwise.1 02_bitwise.2

03_rellogic.s: 03_rellogic.c
	$(CC) -P -S 03_rellogic.c

03_rellogic.1: 03_rellogic.c
	$(CPP) -P 03_rellogic.c > 03_rellogic.i; $(C0) 03_rellogic.i 03_rellogic.1 03_rellogic.2

04_shift.s: 04_shift.c
	$(CC) -P -S 04_shift.c

04_shift.1: 04_shift.c
	$(CPP) -P 04_shift.c > 04_shift.i; $(C0) 04_shift.i 04_shift.1 04_shift.2

05_incdec.s: 05_incdec.c
	$(CC) -P -S 05_incdec.c

05_incdec.1: 05_incdec.c
	$(CPP) -P 05_incdec.c > 05_incdec.i; $(C0) 05_incdec.i 05_incdec.1 05_incdec.2

06_compasgn.s: 06_compasgn.c
	$(CC) -P -S 06_compasgn.c

06_compasgn.1: 06_compasgn.c
	$(CPP) -P 06_compasgn.c > 06_compasgn.i; $(C0) 06_compasgn.i 06_compasgn.1 06_compasgn.2

07_ternary.s: 07_ternary.c
	$(CC) -P -S 07_ternary.c

07_ternary.1: 07_ternary.c
	$(CPP) -P 07_ternary.c > 07_ternary.i; $(C0) 07_ternary.i 07_ternary.1 07_ternary.2

08_castsize.s: 08_castsize.c
	$(CC) -P -S 08_castsize.c

08_castsize.1: 08_castsize.c
	$(CPP) -P 08_castsize.c > 08_castsize.i; $(C0) 08_castsize.i 08_castsize.1 08_castsize.2

clean:
	rm -f *.s *.i *.1 *.2
