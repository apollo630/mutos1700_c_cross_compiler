# Makefile.mutos
#
# Genuine V7/MUTOS make(1)-compatible makefile -- verified against the
# real MUTOS 1700 make(1) manpage, and deliberately NOT the same as the
# other 'Makefile' in this directory, which uses GNU-only syntax
# ($(wildcard), $(dir)/$(notdir), "%.o: %.c" pattern rules, ":=") that
# this make(1) does not have at all. Run this one directly on the real
# MUTOS 1700 hardware / emulator with its own make:
#
#   make -f Makefile.mutos
#   make -f Makefile.mutos clean
#
# Every recipe below is written as ONE shell line (commands joined with
# ";", never split across separate tab-indented lines) on purpose:
# make(1)'s own FEHLERQUELLEN section warns that shell state -- notably
# cd(1) -- does not carry across separate recipe lines, since each line
# is handed to its own subshell.
#
# Does the same two things as ./gen_mutos.sh (which stays as the
# simpler, make-independent alternative -- use whichever's more
# convenient):
#   - "<name>.s"                       via cc -P -S
#   - "<name>.i" + "<name>.1"/"<name>.2" via cpp then /lib/c0, fed cpp's
#     OUTPUT, never the raw .c -- matching what the real cc driver does
#     internally (see the other Makefile's comment block for why).
#
# "<name>.2" is a side effect of the "<name>.1" recipe, not declared as
# its own target below -- if you need just one file's temp2 rebuilt,
# ask for its ".1" target instead.
#
# No GNU-only .PHONY here (this make(1) doesn't have it); "all" and
# "clean" are safe as long as no real file named "all" or "clean" exists
# in this directory, which is true today.

CC  = cc
CPP = /lib/cpp
C0  = /lib/c0

all: \
	00_smoke/01_emptymain.s 00_smoke/01_emptymain.1 \
	00_smoke/02_retconst.s 00_smoke/02_retconst.1 \
	00_smoke/03_retexpr.s 00_smoke/03_retexpr.1 \
	01_expr/01_intarith.s 01_expr/01_intarith.1 \
	01_expr/02_bitwise.s 01_expr/02_bitwise.1 \
	01_expr/03_rellogic.s 01_expr/03_rellogic.1 \
	01_expr/04_shift.s 01_expr/04_shift.1 \
	01_expr/05_incdec.s 01_expr/05_incdec.1 \
	01_expr/06_compasgn.s 01_expr/06_compasgn.1 \
	01_expr/07_ternary.s 01_expr/07_ternary.1 \
	01_expr/08_castsize.s 01_expr/08_castsize.1 \
	02_long/01_addsub.s 02_long/01_addsub.1 \
	02_long/02_muldiv.s 02_long/02_muldiv.1 \
	02_long/03_retval.s 02_long/03_retval.1 \
	02_long/04_params.s 02_long/04_params.1 \
	03_ctrlflow/01_ifelse.s 03_ctrlflow/01_ifelse.1 \
	03_ctrlflow/02_while.s 03_ctrlflow/02_while.1 \
	03_ctrlflow/03_dowhile.s 03_ctrlflow/03_dowhile.1 \
	03_ctrlflow/04_for.s 03_ctrlflow/04_for.1 \
	03_ctrlflow/05_breakcont.s 03_ctrlflow/05_breakcont.1 \
	03_ctrlflow/06_switch.s 03_ctrlflow/06_switch.1 \
	03_ctrlflow/07_goto.s 03_ctrlflow/07_goto.1 \
	04_funcs/01_call.s 04_funcs/01_call.1 \
	04_funcs/02_manyargs.s 04_funcs/02_manyargs.1 \
	04_funcs/03_recfact.s 04_funcs/03_recfact.1 \
	04_funcs/04_mutrec.s 04_funcs/04_mutrec.1 \
	04_funcs/05_staticvar.s 04_funcs/05_staticvar.1 \
	04_funcs/06_regclass.s 04_funcs/06_regclass.1 \
	04_funcs/07_funcptr.s 04_funcs/07_funcptr.1 \
	05_arrptr/01_arrbasic.s 05_arrptr/01_arrbasic.1 \
	05_arrptr/02_array2d.s 05_arrptr/02_array2d.1 \
	05_arrptr/03_ptrbasic.s 05_arrptr/03_ptrbasic.1 \
